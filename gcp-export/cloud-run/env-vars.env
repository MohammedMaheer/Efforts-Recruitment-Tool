# Cloud Run Environment Variables
# ================================
# Non-secret env vars (extracted from Cloud Run service config)
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT=120
GEMINI_DAILY_LIMIT=1500
GOOGLE_CLOUD_PROJECT=efforts-recruitment
EMAIL_ADDRESS=hr@effortz.com

# Secrets (from Secret Manager - need to be re-created in new project)
# These were stored in Secret Manager and must be manually re-entered:
# SECRET_KEY=<generate new or copy from old project>
# JWT_SECRET_KEY=<generate new or copy from old project>
# OPENAI_API_KEY=<your OpenAI API key>
# GEMINI_API_KEY=<your Gemini API key>
# MICROSOFT_CLIENT_ID=<your Microsoft OAuth client ID>
# MICROSOFT_CLIENT_SECRET=<your Microsoft OAuth client secret>
# MICROSOFT_TENANT_ID=<your Microsoft tenant ID>
# EMAIL_PASSWORD=<email password for hr@effortz.com>
# SMTP_PASSWORD=<SMTP password>
# CRON_SECRET=<cron job authentication secret>
